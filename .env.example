# ---------------------------------------------------------------------------
# tailscale-operator — environment variables
# Copy this file to .env, fill in real values, then run ./deploy.sh
# ---------------------------------------------------------------------------

# ── Kubernetes ──────────────────────────────────────────────────────────────
# Namespace where the operator and its proxy pods live.
HOMELAB_NAMESPACE=tailscale

# ── Tailscale OAuth credentials ─────────────────────────────────────────────
# Create an OAuth client at https://login.tailscale.com/admin/settings/oauth
# Required scopes: Devices Core (read + write), Auth Keys (write)
# Recommended tag: tag:k8s-operator  (must exist in your ACL policy)
TAILSCALE_OAUTH_CLIENT_ID=...
TAILSCALE_OAUTH_CLIENT_SECRET=...
